FROM eclipse-temurin:21-jdk-jammy

ARG GHIDRA_VERSION=12.1.3
ARG GHIDRA_DATE=20260817
ARG GHIDRA_SHA256=93a5d11a9ad510622acaaf908c556a7b9b764d338e78a7567f3689bf5081fd54
ARG GHIDRA_ZIP=ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_DATE}.zip
ARG GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/${GHIDRA_ZIP}

ENV GHIDRA_HOME=/opt/ghidra
ENV GHIDRA_PROJECT_DIR=/workspace/ghidra_projects
ENV GHIDRA_SCRIPT_DIR=/opt/fwagent/ghidra_scripts
ENV MAXMEM=4G
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        binutils \
        ca-certificates \
        coreutils \
        curl \
        file \
        findutils \
        grep \
        python3 \
        unzip \
        wget \
    && rm -rf /var/lib/apt/lists/*

RUN if ! command -v 7z >/dev/null 2>&1 && command -v 7zz >/dev/null 2>&1; then \
        ln -s "$(command -v 7zz)" /usr/local/bin/7z; \
    fi

RUN mkdir -p /opt/fwagent /workspace/ghidra_projects \
    && curl --fail --silent --show-error --location --retry 5 --retry-delay 5 --retry-all-errors --connect-timeout 30 --speed-limit 1024 --speed-time 60 "$GHIDRA_URL" -o "/tmp/${GHIDRA_ZIP}" \
    && echo "${GHIDRA_SHA256}  /tmp/${GHIDRA_ZIP}" | sha256sum -c - \
    && unzip -q "/tmp/${GHIDRA_ZIP}" -d /opt \
    && ln -s "/opt/ghidra_${GHIDRA_VERSION}_PUBLIC" "$GHIDRA_HOME" \
    && rm "/tmp/${GHIDRA_ZIP}"

COPY ghidra_scripts/ "$GHIDRA_SCRIPT_DIR"/
COPY scripts/test_ghidra_environment.sh /opt/fwagent/test_ghidra_environment.sh
COPY docker/entrypoint-ghidra.sh /usr/local/bin/entrypoint-ghidra

RUN chmod +x /opt/fwagent/test_ghidra_environment.sh /usr/local/bin/entrypoint-ghidra \
    && java -version \
    && "$GHIDRA_HOME/support/analyzeHeadless" -version >/tmp/ghidra-version.txt

WORKDIR /workspace
ENTRYPOINT ["entrypoint-ghidra"]
